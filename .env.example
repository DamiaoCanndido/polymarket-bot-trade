# ==============================================================================
# Polymarket Copytrading Bot - Environment Variables Template
# Copy this file to .env and configure your values: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Execution Mode (Paper Trading vs Live Money)
# ------------------------------------------------------------------------------
# Set to 'false' to trade with REAL MONEY. Set to 'true' for simulation/paper trading.
DRY_RUN=true

# ------------------------------------------------------------------------------
# 2. Bullpen CLI & RPC Settings
# ------------------------------------------------------------------------------
# Absolute path to the bullpen binary
BULLPEN_PATH=/home/nergal/.bullpen/bin/bullpen

# Bullpen data directory
BULLPEN_HOME=/home/nergal/.bullpen

# Bullpen environment: production | staging
BULLPEN_ENV=production

# Custom Polygon RPC endpoint (optional, defaults to Bullpen public RPC)
# BULLPEN_POLYGON_RPC_URL=https://polygon-rpc.com

# ------------------------------------------------------------------------------
# 3. Polymarket Wallet & API Credentials (Optional / Direct Access)
# ------------------------------------------------------------------------------
# Your Polymarket / Polygon wallet address (0x...)
POLYMARKET_WALLET_ADDRESS=

# Private key (Keep strictly confidential! Do not commit to git)
POLYMARKET_PRIVATE_KEY=

# Polymarket CLOB API Credentials (if interacting directly with CLOB API)
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# ------------------------------------------------------------------------------
# 4. Trading Sizing & Risk Management Defaults
# ------------------------------------------------------------------------------
# Sizing mode: 'fixed' or 'percentage'
SIZING_MODE=fixed

# Amount in USD to allocate per copied trade in fixed mode
FIXED_AMOUNT_USD=10.0

# Max percentage of trader size to mirror in percentage mode
MIRROR_PERCENT_CAP=10.0

# Max total USD deployed per day (circuit breaker)
DAILY_BUDGET_USD=100.0

# Max total USD exposure in a single market outcome
MAX_PER_MARKET_USD=50.0

# Hard cap per single trade execution
MAX_TRADE_SIZE_USD=25.0

# Minimum trade size in USD to mirror
MIN_TRADE_SIZE_USD=1.0

# Max price slippage allowed (in percentage, e.g., 2.0 = 2%)
SLIPPAGE_TOLERANCE_PCT=2.0

# Allowed outcome price range (avoids extreme odds)
MIN_PRICE=0.05
MAX_PRICE=0.95

# Automatically mirror sell orders when master trader sells
AUTO_EXIT_ON_SELL=true

# Polling frequency in seconds
POLL_INTERVAL_SECONDS=5

# ------------------------------------------------------------------------------
# 5. Dashboard Web Server Settings
# ------------------------------------------------------------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000
FLASK_SECRET_KEY=change-this-to-a-secure-random-secret-key
